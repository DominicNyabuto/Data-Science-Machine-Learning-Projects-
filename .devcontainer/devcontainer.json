{
  "name": "Python 3",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",

  //Add MongoDB and Docker-in-Docker to container automatically
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:1": {},
    "ghcr.io/microsoft/vscode-dev-containers/features/mongodb:1": {}
  },

  "customizations": {
    "vscode": {
      "settings": {},
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "mongodb.mongodb-vscode"
      ]
    }
  },
  "updateContentCommand": "[ -f packages.txt ] && sudo apt update && sudo apt upgrade -y && sudo xargs apt install -y <packages.txt; [ -f requirements.txt ] && pip3 install --user -r requirements.txt; pip3 install --user streamlit; echo '✅ Packages installed and Requirements met'",

  "portsAttributes": {
    "27017": {
      "label": "MongoDB",
      "onAutoForward": "ignore"
    }
  },
  // Forwards port 27017 so you can connect locally or view it in the Ports tab
  "forwardPorts": [27017],
  "postCreateCommand": "echo '✅ Devcontainer created successfully!'"
}
