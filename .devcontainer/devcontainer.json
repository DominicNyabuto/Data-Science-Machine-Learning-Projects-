{
  "name": "WQU-Projects",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",

  // Add MongoDB and Docker-in-Docker to container automatically
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:1": {},
    "ghcr.io/devcontainers/features/mongodb:1": {}
  },

  "customizations": {
    "vscode": {
      "settings": {},
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-toolsai.jupyter",
        "mongodb.mongodb-vscode"
      ]
    }
  },

  // Installs Linux system packages if packages.txt exists
  "updateContentCommand": "[ -f packages.txt ] && sudo apt update && sudo apt upgrade -y && sudo xargs apt install -y <packages.txt; echo '✅ System packages processed'",

  // Installs common python dependencies across your 8 projects
  "postCreateCommand": "[ -f requirements.txt ] && pip3 install --user -r requirements.txt; echo '✅ Devcontainer created and requirements met!'",

  "portsAttributes": {
    "27017": {
      "label": "MongoDB",
      "onAutoForward": "ignore"
    }
  },

  // Forwards port 27017 so you can connect locally or view it in the Ports tab
  "forwardPorts": [27017]
}
